#!/usr/bin/env bash
# SessionStart hook for the Octapowers Claude Code plugin.

set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
plugin_root="$(cd "${script_dir}/.." && pwd)"

using_octapowers_content=$(cat "${plugin_root}/skills/using-octapowers/SKILL.md" 2>&1 || echo "Error reading using-octapowers skill")

escape_for_json() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\t'/\\t}"
    printf '%s' "$value"
}

using_octapowers_escaped=$(escape_for_json "$using_octapowers_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have Octapowers.\n\n**Below is the full content of your 'octapowers:using-octapowers' skill. For all other skills, use the Skill tool:**\n\n${using_octapowers_escaped}\n</EXTREMELY_IMPORTANT>"

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
